<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="myschool_admin.Dashboard" owl="1">
        <div class="db-container">
            <!-- Loading -->
            <t t-if="state.loading">
                <div class="db-loading">
                    <i class="fa fa-spinner fa-spin fa-2x"/>
                    <p>Dashboard laden…</p>
                </div>
            </t>
            <t t-else="">
                <div class="db-page">
                    <!-- ============================================ -->
                    <!-- Begroeting (calm-tech header)                -->
                    <!-- ============================================ -->
                    <div class="db-greeting">
                        <h1>
                            <t t-esc="greeting"/><t t-if="firstName">, <t t-esc="firstName"/></t>
                        </h1>
                        <p class="db-greeting-sub"><t t-esc="todayLabel"/></p>
                    </div>

                    <!-- ============================================ -->
                    <!-- Hero: Organisatiebeheer-CTA                  -->
                    <!-- ============================================ -->
                    <div class="db-hero">
                        <div class="db-hero-icon">
                            <Icon name="'sitemap'" size="28"/>
                        </div>
                        <div class="db-hero-text">
                            <h2>Organisatiebeheer</h2>
                            <p>Doorblader de volledige organisatiehiërarchie en beheer personen, rollen en relaties op één plek.</p>
                            <div class="db-hero-stats">
                                <div class="db-hero-stat">
                                    <strong><t t-esc="formatNumber(state.heroStats.organizations)"/></strong> organisaties
                                </div>
                                <div class="db-hero-stat">
                                    <strong><t t-esc="formatNumber(state.heroStats.persons)"/></strong> personen
                                </div>
                                <div class="db-hero-stat">
                                    <strong><t t-esc="formatNumber(state.heroStats.roles)"/></strong> rollen
                                </div>
                            </div>
                        </div>
                        <button class="db-hero-btn" t-on-click="openObjectBrowser">
                            <Icon name="'sitemap'" size="16"/> Open organisatiebeheer
                        </button>
                    </div>

                    <!-- ============================================ -->
                    <!-- KPI-rij                                      -->
                    <!-- ============================================ -->
                    <div class="db-kpi-row">
                        <div class="db-kpi-card db-kpi-c1">
                            <div class="db-kpi-label">Actieve leerlingen</div>
                            <div class="db-kpi-value"><t t-esc="formatNumber(state.kpis.active_students)"/></div>
                            <div class="db-kpi-sub">ingeschreven dit schooljaar</div>
                        </div>
                        <div class="db-kpi-card db-kpi-c2">
                            <div class="db-kpi-label">Actieve medewerkers</div>
                            <div class="db-kpi-value"><t t-esc="formatNumber(state.kpis.active_employees)"/></div>
                            <div class="db-kpi-sub">actief in systeem</div>
                        </div>
                        <div class="db-kpi-card db-kpi-c3">
                            <div class="db-kpi-label">Organisaties</div>
                            <div class="db-kpi-value"><t t-esc="formatNumber(state.kpis.organizations)"/></div>
                            <div class="db-kpi-sub"><t t-esc="state.kpis.classgroups || 0"/> klasgroepen</div>
                        </div>
                        <div class="db-kpi-card db-kpi-c4">
                            <div class="db-kpi-label">Openstaande taken</div>
                            <div class="db-kpi-value"><t t-esc="formatNumber(state.kpis.pending_tasks)"/></div>
                            <div class="db-kpi-sub">
                                <t t-if="state.kpis.error_tasks > 0">
                                    <span class="db-kpi-down"><t t-esc="state.kpis.error_tasks"/> fouten</span>
                                </t>
                                <t t-else="">alles in orde</t>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================ -->
                    <!-- Hoofdgrid: 2fr | 1fr                         -->
                    <!-- ============================================ -->
                    <div class="db-grid">
                        <!-- LINKERkolom -->
                        <div class="db-grid-left">
                            <!-- Recente backend-taken -->
                            <div class="db-card">
                                <div class="db-card-header">
                                    <span>Recente backend-taken</span>
                                    <a class="db-card-link" t-on-click="openTasks">Alles bekijken &#x2192;</a>
                                </div>
                                <table class="db-mini-table">
                                    <thead>
                                        <tr>
                                            <th>Taak</th>
                                            <th>Type</th>
                                            <th>Status</th>
                                            <th>Aangemaakt</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.recentTasks" t-as="task" t-key="task.id">
                                            <tr>
                                                <td><t t-esc="task.name"/></td>
                                                <td><span class="db-badge-status db-badge-neutral"><t t-esc="task.type"/></span></td>
                                                <td><span t-att-class="statusBadgeClass(task.status)"><t t-esc="statusLabel(task.status)"/></span></td>
                                                <td><t t-esc="task.created"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.recentTasks.length">
                                            <tr><td colspan="4" class="db-empty-cell">Geen recente taken</td></tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                            <!-- Systeemgebeurtenissen -->
                            <div class="db-card">
                                <div class="db-card-header">
                                    <span>Systeemgebeurtenissen</span>
                                    <a class="db-card-link" t-on-click="openEvents">Alles bekijken &#x2192;</a>
                                </div>
                                <table class="db-mini-table">
                                    <thead>
                                        <tr>
                                            <th>Gebeurtenis</th>
                                            <th>Ernst</th>
                                            <th>Tijd</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.systemEvents" t-as="ev" t-key="ev.id">
                                            <tr>
                                                <td><t t-esc="ev.name"/></td>
                                                <td><span t-att-class="severityBadgeClass(ev.severity)"><t t-esc="severityLabel(ev.severity)"/></span></td>
                                                <td><t t-esc="ev.time"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.systemEvents.length">
                                            <tr><td colspan="3" class="db-empty-cell">Geen recente gebeurtenissen</td></tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- RECHTERkolom -->
                        <div class="db-grid-right">
                            <!-- Snelle acties -->
                            <div class="db-card">
                                <div class="db-card-header">Snelle acties</div>
                                <div class="db-card-body">
                                    <div class="db-quick-actions">
                                        <a class="db-qa-btn" t-on-click="openObjectBrowser">
                                            <div class="db-qa-icon db-qa-c1"><Icon name="'sitemap'"/></div>
                                            <div class="db-qa-text">
                                                <strong>Organisatiebeheer</strong>
                                                <span>Doorblader de hiërarchie</span>
                                            </div>
                                        </a>
                                        <a class="db-qa-btn" t-on-click="openPersons">
                                            <div class="db-qa-icon db-qa-c2"><Icon name="'user-plus'"/></div>
                                            <div class="db-qa-text">
                                                <strong>Personen</strong>
                                                <span>Medewerkers &amp; leerlingen</span>
                                            </div>
                                        </a>
                                        <a class="db-qa-btn" t-on-click="openPendingTasks">
                                            <div class="db-qa-icon db-qa-c3"><Icon name="'tasks'"/></div>
                                            <div class="db-qa-text">
                                                <strong>Openstaande taken</strong>
                                                <span><t t-esc="state.kpis.pending_tasks || 0"/> openstaand</span>
                                            </div>
                                        </a>
                                        <a class="db-qa-btn" t-on-click="openEvents">
                                            <div class="db-qa-icon db-qa-c4"><Icon name="'bell'"/></div>
                                            <div class="db-qa-text">
                                                <strong>Systeemgebeurtenissen</strong>
                                                <span>Alle gebeurtenissen</span>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Recente activiteit -->
                            <div class="db-card">
                                <div class="db-card-header">Recente activiteit</div>
                                <div class="db-card-body">
                                    <ul class="db-timeline">
                                        <t t-foreach="state.recentActivity" t-as="item" t-key="item_index">
                                            <li t-att-class="activityClass(item.status)">
                                                <t t-esc="item.text"/>
                                                <br/>
                                                <span class="db-tl-time"><t t-esc="item.time"/></span>
                                            </li>
                                        </t>
                                        <t t-if="!state.recentActivity.length">
                                            <li class="db-tl-item db-tl-info">Geen recente activiteit</li>
                                        </t>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
