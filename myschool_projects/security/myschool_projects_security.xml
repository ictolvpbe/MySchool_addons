<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

    <!-- App-categorie + privilege zodat de groepen als één selectievak
         "Project access" (User / Manager / See all) onder de kop "Projects"
         in de Access Rights-tab verschijnen (Odoo 19: res.groups.privilege). -->
    <record id="module_category_projects" model="ir.module.category">
        <field name="name">Projects</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_projects" model="res.groups.privilege">
        <field name="name">Project access</field>
        <field name="category_id" ref="module_category_projects"/>
        <field name="sequence">25</field>
        <field name="placeholder">No access</field>
    </record>

    <record id="group_projects_user" model="res.groups">
        <field name="name">User: own / member projects</field>
        <field name="privilege_id" ref="privilege_projects"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Read access to MySchool Projects.</field>
    </record>

    <record id="group_projects_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_projects"/>
        <field name="implied_ids" eval="[(4, ref('group_projects_user'))]"/>
        <field name="comment">Full access to MySchool Projects.</field>
    </record>

    <!-- Hoogste niveau: ziet en beheert ALLE projecten (overstijgt de
         eigen/team-record-rule) + mag eigenaar/team wijzigen. -->
    <record id="group_projects_see_all" model="res.groups">
        <field name="name">See all projects</field>
        <field name="privilege_id" ref="privilege_projects"/>
        <field name="implied_ids" eval="[(4, ref('group_projects_manager'))]"/>
        <field name="comment">See and manage every project, regardless of ownership/membership.</field>
    </record>

    <!-- MySchool admin krijgt automatisch Projects Manager-toegang -->
    <record id="myschool_core.group_myschool_core_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_projects_manager'))]"/>
    </record>

    </data>
</odoo>
