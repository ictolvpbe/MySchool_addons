<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="myschool_projects.ContextMenu">
        <div class="o_msp_ctx_backdrop"
             t-on-click="() => props.onClose()"
             t-on-contextmenu.prevent="() => props.onClose()"/>
        <div class="o_msp_ctx" t-attf-style="left: {{ props.x }}px; top: {{ props.y }}px;">
            <div class="o_msp_ctx_header" t-esc="props.title"/>
            <t t-foreach="props.items" t-as="it" t-key="it.action || ('d' + it_index)">
                <div t-if="it.divider" class="o_msp_ctx_divider"/>
                <div t-else="" class="o_msp_ctx_item"
                     t-att-class="{ 'o_msp_ctx_danger': it.danger }"
                     t-on-click="() => this.onItem(it.action)">
                    <i t-att-class="it.icon"/>
                    <span t-esc="it.label"/>
                </div>
            </t>
        </div>
    </t>

    <t t-name="myschool_projects.WbsNode">
        <div class="o_msp_node">
            <div class="o_msp_node_row"
                 draggable="true"
                 t-att-class="{ 'o_msp_node_selected': isSelected, 'o_msp_node_drop': isDropTarget }"
                 t-attf-style="padding-left: {{ level * 14 + 6 }}px;"
                 t-on-click="onRowClick"
                 t-on-contextmenu="onContextMenu"
                 t-on-dragstart="onDragStart"
                 t-on-dragover="onDragOver"
                 t-on-dragleave="onDragLeave"
                 t-on-drop="onDrop"
                 t-on-dragend="onDragEnd">
                <span class="o_msp_caret" t-if="hasChildren" t-on-click="onCaretClick">
                    <i class="fa" t-att-class="isExpanded ? 'fa-caret-down' : 'fa-caret-right'"/>
                </span>
                <span class="o_msp_caret_spacer" t-else=""/>
                <span class="o_msp_node_name" t-esc="props.node.name"/>
                <span class="o_msp_node_pct" t-esc="pct + '%'"/>
            </div>
            <div class="o_msp_children" t-if="hasChildren and isExpanded">
                <t t-foreach="props.node.children" t-as="child" t-key="child.id">
                    <WbsNode node="child" level="childLevel"
                             selectedId="props.selectedId"
                             expanded="props.expanded"
                             dragId="props.dragId"
                             dropTargetId="props.dropTargetId"
                             onSelect="props.onSelect"
                             onToggle="props.onToggle"
                             onContextMenu="props.onContextMenu"
                             onDragStart="props.onDragStart"
                             onDragOver="props.onDragOver"
                             onDragLeave="props.onDragLeave"
                             onDrop="props.onDrop"
                             onDragEnd="props.onDragEnd"/>
                </t>
            </div>
        </div>
    </t>

    <t t-name="myschool_projects.WorkPackageTable">
        <div class="o_msp_wp" t-on-contextmenu="onEmptyContextMenu">
            <div class="o_msp_wp_toolbar">
                <button class="btn btn-sm btn-primary" t-on-click="createItem">
                    <i class="fa fa-plus me-1"/>Create
                </button>
                <input type="text" class="o_msp_wp_search"
                       placeholder="Zoek work item…"
                       t-model="state.search"/>
                <div class="o_msp_colcfg ms-auto">
                    <button class="btn btn-sm btn-light" t-on-click="toggleColMenu" title="Columns">
                        <i class="fa fa-cog"/>
                    </button>
                    <div class="o_msp_colmenu" t-if="state.colMenuOpen">
                        <t t-foreach="columnDefs" t-as="c" t-key="c.key">
                            <label class="o_msp_colmenu_item">
                                <input type="checkbox" t-att-checked="state.cols[c.key]"
                                       t-on-change="() => this.toggleCol(c.key)"/>
                                <span t-esc="c.label"/>
                            </label>
                        </t>
                    </div>
                </div>
            </div>
            <table class="o_msp_wp_table">
                <thead>
                    <tr>
                        <th class="o_msp_wp_type" t-if="state.cols.type">Type</th>
                        <th class="o_msp_wp_id" t-if="state.cols.id">ID</th>
                        <th class="o_msp_wp_subject">Subject</th>
                        <th t-if="state.cols.status">Status</th>
                        <th t-if="state.cols.milestone">Milestone</th>
                        <th t-if="state.cols.assignee">Assignee</th>
                        <th t-if="state.cols.priority">Priority</th>
                        <th t-if="state.cols.start">Start</th>
                        <th t-if="state.cols.deadline">Deadline</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="visibleRows" t-as="row" t-key="row.item.id">
                        <tr class="o_msp_wp_row"
                            t-att-class="{
                                'o_msp_summary': row.hasChildren,
                                'o_msp_milestone_row': row.item.item_type === 'milestone',
                                'o_msp_drop_onto': state.dragOverId === row.item.id and state.dropMode === 'onto',
                                'o_msp_drop_before': state.dragOverId === row.item.id and state.dropMode === 'before',
                                'o_msp_drop_after': state.dragOverId === row.item.id and state.dropMode === 'after' }"
                            t-on-dragover="(ev) => this.onDragOver(ev, row.item)"
                            t-on-dragleave="() => this.onDragLeave(row.item)"
                            t-on-drop="(ev) => this.onDrop(ev, row.item)"
                            t-on-contextmenu="(ev) => this.onRowContextMenu(ev, row.item)">
                            <td t-if="state.cols.type">
                                <span t-if="row.hasChildren"
                                      class="o_msp_type_badge o_msp_type_cluster">Cluster</span>
                                <span t-else="" class="o_msp_type_badge"
                                      t-attf-class="o_msp_type_{{ row.item.item_type }}"
                                      t-esc="typeLabels[row.item.item_type] || row.item.item_type"/>
                            </td>
                            <td t-if="state.cols.id" class="o_msp_wp_id o_msp_link text-muted"
                                t-on-click="() => this.openItem(row.item.id)"
                                t-esc="row.item.id"/>
                            <td>
                                <span class="o_msp_subject_cell"
                                      t-attf-style="padding-left: {{ row.depth * 18 }}px;">
                                    <span class="o_msp_drag" draggable="true"
                                          t-on-dragstart="(ev) => this.onDragStart(ev, row.item)"
                                          t-on-dragend="() => this.onDragEnd()"
                                          title="Sleep om onder een ander item te hangen">⠿</span>
                                    <span class="o_msp_caret" t-if="row.hasChildren"
                                          t-on-click.stop="() => this.toggle(row.item.id)">
                                        <i class="fa"
                                           t-att-class="state.expanded[row.item.id] ? 'fa-caret-down' : 'fa-caret-right'"/>
                                    </span>
                                    <span class="o_msp_caret_spacer" t-else=""/>
                                    <span class="o_msp_diamond"
                                          t-if="row.item.item_type === 'milestone'">◆</span>
                                    <i class="fa fa-folder o_msp_summary_icon"
                                       t-elif="row.hasChildren"/>
                                    <t t-if="state.editingId === row.item.id">
                                        <input class="o_msp_inline_input" t-ref="renameInput"
                                               t-model="state.editingName"
                                               t-on-keydown="(ev) => this.onRenameKeydown(ev, row.item)"
                                               t-on-blur="() => this.saveRename(row.item)"/>
                                    </t>
                                    <t t-else="">
                                        <span class="o_msp_subject_text o_msp_link"
                                              t-att-class="{ 'o_msp_summary_text': row.hasChildren }"
                                              t-on-click="() => this.openItem(row.item.id)"
                                              t-esc="row.item.name"/>
                                        <button class="o_msp_rowbtn" title="Rename"
                                                t-on-click.stop="() => this.startRename(row.item)">
                                            <i class="fa fa-pencil"/>
                                        </button>
                                        <button class="o_msp_rowbtn" title="Add sub-item"
                                                t-on-click.stop="() => this.addChild(row.item)">
                                            <i class="fa fa-plus"/>
                                        </button>
                                    </t>
                                </span>
                            </td>
                            <td t-if="state.cols.status">
                                <!-- Summary rows show rolled-up progress instead of a status. -->
                                <t t-if="row.hasChildren">
                                    <div class="o_msp_rollup">
                                        <div class="o_msp_rollup_bar">
                                            <div class="o_msp_rollup_fill"
                                                 t-attf-style="width: {{ summaryPct(row.item) }}%;"/>
                                        </div>
                                        <span class="o_msp_rollup_pct"
                                              t-esc="summaryPct(row.item) + '%'"/>
                                    </div>
                                </t>
                                <t t-elif="state.statusOpenId === row.item.id">
                                    <select class="o_msp_status_select"
                                            t-on-change="(ev) => this.setStatus(row.item, ev.target.value)"
                                            t-on-blur="() => this.closeStatus()">
                                        <option t-foreach="stateOptionList" t-as="s" t-key="s.key"
                                                t-att-value="s.key"
                                                t-att-selected="s.key === row.item.state"
                                                t-esc="s.label"/>
                                    </select>
                                </t>
                                <t t-else="">
                                    <span class="o_msp_status_badge o_msp_link"
                                          t-attf-class="o_msp_status_{{ row.item.state }}"
                                          t-on-click="() => this.openStatus(row.item.id)"
                                          t-esc="stateLabels[row.item.state] || row.item.state"/>
                                </t>
                            </td>
                            <td t-if="state.cols.milestone"
                                t-esc="row.item.milestone_id ? row.item.milestone_id[1] : ''"/>
                            <td t-if="state.cols.assignee"
                                t-esc="row.item.assigned_id ? row.item.assigned_id[1] : ''"/>
                            <td t-if="state.cols.priority">
                                <span t-attf-class="o_msp_prio o_msp_prio_{{ row.item.priority }}"
                                      t-esc="priorityLabels[row.item.priority] || ''"/>
                            </td>
                            <td t-if="state.cols.start" t-esc="row.item.date_start or ''"/>
                            <td t-if="state.cols.deadline" t-esc="row.item.date_deadline or ''"/>
                        </tr>
                    </t>
                    <tr t-if="!visibleRows.length and !state.loading">
                        <td t-att-colspan="colCount" class="text-muted p-3">
                            Nog geen work items. Klik op + Create.
                        </td>
                    </tr>
                </tbody>
            </table>

            <div class="o_msp_wp_dropzone"
                 t-att-class="{ 'o_msp_dropzone_active': state.dragOverId === 'bottom' }"
                 t-on-dragover="onDropZoneOver"
                 t-on-dragleave="onDropZoneLeave"
                 t-on-drop="onDropBottom">
                <span class="o_msp_dropzone_hint">Sleep hier om onderaan te plaatsen (top-level)</span>
            </div>

            <WsContextMenu t-if="state.ctx" x="state.ctx.x" y="state.ctx.y"
                           title="'Work item'" items="ctxItems"
                           onAction.bind="onCtxAction" onClose.bind="closeCtx"/>
        </div>
    </t>

    <t t-name="myschool_projects.GanttTimeline">
        <div class="o_msp_gantt_wrap">
            <div class="o_msp_gantt_toolbar">
                <span class="text-muted small">Timeline</span>
                <button class="btn btn-sm ms-3"
                        t-att-class="state.showDeps ? 'btn-primary' : 'btn-light'"
                        t-on-click="toggleDeps" title="Toon/verberg dependency-pijlen">
                    <i class="fa fa-link me-1"/>Dependencies
                </button>
                <div class="ms-auto btn-group">
                    <button class="btn btn-sm btn-light" t-on-click="() => this.zoom(-4)" title="Uitzoomen">
                        <i class="fa fa-search-minus"/>
                    </button>
                    <button class="btn btn-sm btn-light" t-on-click="() => this.zoom(4)" title="Inzoomen">
                        <i class="fa fa-search-plus"/>
                    </button>
                </div>
            </div>
            <t t-if="state.loading">
                <div class="text-muted p-3">Laden…</div>
            </t>
            <t t-elif="!visibleRows.length">
                <div class="text-muted p-3">Nog geen work items.</div>
            </t>
            <t t-else="">
                <div class="o_msp_gantt">
                    <div class="o_msp_gantt_inner"
                         t-attf-style="width: {{ labelW + timelineWidth }}px;">
                        <!-- HEADER -->
                        <div class="o_msp_gantt_head">
                            <div class="o_msp_gantt_corner"
                                 t-attf-style="width: {{ labelW }}px;">Work item</div>
                            <div class="o_msp_gantt_head_tl"
                                 t-attf-style="width: {{ timelineWidth }}px;">
                                <div class="o_msp_gantt_months">
                                    <t t-foreach="months" t-as="mo" t-key="mo.key">
                                        <div class="o_msp_gantt_month"
                                             t-attf-style="left: {{ mo.left }}px; width: {{ mo.width }}px;"
                                             t-esc="mo.label"/>
                                    </t>
                                </div>
                                <div class="o_msp_gantt_days">
                                    <t t-foreach="days" t-as="dy" t-key="dy.key">
                                        <div class="o_msp_gantt_day"
                                             t-att-class="{ 'o_msp_gantt_weekend': dy.weekend }"
                                             t-attf-style="left: {{ dy.left }}px; width: {{ dy.width }}px;"
                                             t-esc="dy.num"/>
                                    </t>
                                </div>
                            </div>
                        </div>
                        <!-- BODY -->
                        <div class="o_msp_gantt_body">
                            <div class="o_msp_gantt_today" t-if="todayLeft !== null"
                                 t-attf-style="left: {{ labelW + todayLeft }}px;"/>
                            <t t-foreach="visibleRows" t-as="row" t-key="row.item.id">
                                <div class="o_msp_gantt_row"
                                     t-att-class="{ 'o_msp_summary': row.hasChildren,
                                                    'o_msp_milestone_row': row.item.item_type === 'milestone' }">
                                    <div class="o_msp_gantt_label"
                                         t-attf-style="width: {{ labelW }}px; padding-left: {{ row.depth * 16 + 8 }}px;">
                                        <span class="o_msp_caret" t-if="row.hasChildren"
                                              t-on-click.stop="() => this.toggle(row.item.id)">
                                            <i class="fa"
                                               t-att-class="state.expanded[row.item.id] ? 'fa-caret-down' : 'fa-caret-right'"/>
                                        </span>
                                        <span class="o_msp_caret_spacer" t-else=""/>
                                        <span class="o_msp_diamond"
                                              t-if="row.item.item_type === 'milestone'">◆</span>
                                        <i class="fa fa-folder o_msp_summary_icon"
                                           t-elif="row.hasChildren"/>
                                        <span class="o_msp_gantt_label_text o_msp_link"
                                              t-att-class="{ 'o_msp_summary_text': row.hasChildren }"
                                              t-on-click="() => this.openItem(row.item.id)"
                                              t-esc="row.item.name"/>
                                    </div>
                                    <div class="o_msp_gantt_track"
                                         t-attf-style="width: {{ timelineWidth }}px; background-size: {{ state.dayWidth }}px 100%;">
                                        <t t-if="row.item.item_type === 'milestone'">
                                            <div class="o_msp_gantt_ms"
                                                 t-if="milestoneLeft(row.item) !== null"
                                                 t-attf-style="left: {{ milestoneLeft(row.item) }}px;"
                                                 t-att-title="row.item.name"
                                                 t-on-mousedown="(ev) => this.onBarMouseDown(ev, row, 'move')"
                                                 t-on-click="() => this.onBarClick(row)"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="bar" t-value="barFor(row)"/>
                                            <div t-if="bar" class="o_msp_gantt_bar"
                                                 t-att-class="row.hasChildren ? 'o_msp_gantt_bar_summary' : ('o_msp_gantt_bar_' + row.item.item_type + ' o_msp_gantt_st_' + row.item.state)"
                                                 t-attf-style="left: {{ bar.left }}px; width: {{ bar.width }}px;"
                                                 t-att-title="row.item.name"
                                                 t-on-mousedown="(ev) => this.onBarMouseDown(ev, row, 'move')"
                                                 t-on-click="() => this.onBarClick(row)">
                                                <span t-if="!row.hasChildren" class="o_msp_gantt_handle o_msp_gantt_handle_l"
                                                      t-on-mousedown.stop="(ev) => this.onBarMouseDown(ev, row, 'resize-l')"/>
                                                <span class="o_msp_gantt_bar_label" t-esc="row.item.name"/>
                                                <span t-if="!row.hasChildren" class="o_msp_gantt_handle o_msp_gantt_handle_r"
                                                      t-on-mousedown.stop="(ev) => this.onBarMouseDown(ev, row, 'resize-r')"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                            <svg class="o_msp_gantt_deps" t-if="state.showDeps and arrows.length"
                                 t-attf-width="{{ labelW + timelineWidth }}"
                                 t-attf-height="{{ visibleRows.length * rowH }}"
                                 t-attf-style="height: {{ visibleRows.length * rowH }}px;">
                                <t t-foreach="arrows" t-as="ar" t-key="ar.key">
                                    <path t-att-d="ar.d" class="o_msp_gantt_dep_path"/>
                                    <polygon t-att-points="ar.head" class="o_msp_gantt_dep_head"/>
                                </t>
                            </svg>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>

    <t t-name="myschool_projects.Workspace">
        <div class="o_msp_workspace">
            <!-- ====== SIDEBAR: WBS ====== -->
            <div class="o_msp_sidebar" t-attf-style="width: {{ state.sidebarWidth }}px;">
                <div class="o_msp_sidebar_head">
                    <span class="o_msp_sidebar_title">Projects</span>
                    <input type="text" class="o_msp_search"
                           placeholder="Zoek project…"
                           t-model="state.search"/>
                </div>
                <div class="o_msp_tree" t-on-contextmenu="onEmptyContextMenu">
                    <t t-if="state.loading">
                        <div class="text-muted p-2">Laden…</div>
                    </t>
                    <t t-elif="!filteredRoots.length">
                        <div t-if="state.search" class="text-muted p-2">Geen resultaten</div>
                        <div t-else="" class="text-muted p-2">Geen projecten</div>
                    </t>
                    <t t-else="">
                        <t t-foreach="filteredRoots" t-as="node" t-key="node.id">
                            <WbsNode node="node" level="0"
                                     selectedId="state.selectedId"
                                     expanded="state.expanded"
                                     dragId="state.dragId"
                                     dropTargetId="state.dropTargetId"
                                     onSelect.bind="selectProject"
                                     onToggle.bind="onToggle"
                                     onContextMenu.bind="onNodeContextMenu"
                                     onDragStart.bind="onNodeDragStart"
                                     onDragOver.bind="onNodeDragOver"
                                     onDragLeave.bind="onNodeDragLeave"
                                     onDrop.bind="onNodeDrop"
                                     onDragEnd.bind="onNodeDragEnd"/>
                        </t>
                        <div class="o_msp_root_dropzone"
                             t-att-class="{ 'o_msp_dropzone_active': state.dropTargetId === 'root' }"
                             t-on-dragover="onRootDragOver"
                             t-on-dragleave="onRootDragLeave"
                             t-on-drop="onRootDrop">
                            Sleep hier voor niveau 0 (hoofdproject)
                        </div>
                    </t>
                </div>
            </div>

            <!-- ====== SPLITTER ====== -->
            <div class="o_msp_splitter" t-on-mousedown="onSplitterDown"/>

            <!-- ====== MAIN ====== -->
            <div class="o_msp_main">
                <t t-if="state.loading">
                    <div class="o_msp_empty text-muted">Laden…</div>
                </t>
                <t t-elif="!state.roots.length">
                    <!-- Verse install: nog geen enkel project -->
                    <div class="o_msp_nocontent">
                        <i class="fa fa-folder-open-o o_msp_nocontent_icon"/>
                        <h3>Nog geen projecten</h3>
                        <p class="text-muted">
                            Maak je eerste project aan om te beginnen. Projecten kunnen
                            sub-projecten (WBS), work items, milestones en een tijdlijn bevatten.
                        </p>
                        <button class="btn btn-primary" t-on-click="() => this._newProject(false)">
                            <i class="fa fa-plus me-1"/>Nieuw project
                        </button>
                    </div>
                </t>
                <t t-elif="!selected">
                    <div class="o_msp_empty text-muted">Selecteer een project links.</div>
                </t>
                <t t-else="">
                    <div class="o_msp_topbar">
                        <div class="o_msp_title">
                            <span class="o_msp_proj_name" t-esc="selected.name"/>
                            <span t-if="selected.code" class="o_msp_proj_code" t-esc="selected.code"/>
                        </div>
                        <div class="o_msp_switch btn-group">
                            <button class="btn btn-sm"
                                    t-att-class="state.view === 'table' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.setView('table')">Table</button>
                            <button class="btn btn-sm"
                                    t-att-class="state.view === 'timeline' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.setView('timeline')">Timeline</button>
                            <button class="btn btn-sm"
                                    t-att-class="state.view === 'overview' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.setView('overview')">Overview</button>
                            <button class="btn btn-sm"
                                    t-att-class="state.view === 'kanban' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.setView('kanban')">Board</button>
                            <button class="btn btn-sm"
                                    t-att-class="state.view === 'calendar' ? 'btn-primary' : 'btn-secondary'"
                                    t-on-click="() => this.setView('calendar')">Calendar</button>
                        </div>
                        <button class="btn btn-sm btn-light ms-auto"
                                t-on-click="applyProcess"
                                title="Voeg een proces (uit de Process Composer) in als taken">
                            <i class="fa fa-sitemap me-1"/>Voeg proces in
                        </button>
                        <button class="btn btn-sm btn-light o_msp_openform"
                                t-on-click="openProjectForm">Open form</button>
                    </div>

                    <div class="o_msp_content">
                        <!-- TABLE (custom hierarchical work-packages) -->
                        <t t-if="state.view === 'table'">
                            <WorkPackageTable t-key="state.selectedId + '-' + state.taskReload"
                                              projectId="state.selectedId"/>
                        </t>
                        <!-- TIMELINE (custom gantt) -->
                        <t t-elif="state.view === 'timeline'">
                            <GanttTimeline t-key="state.selectedId + '-' + state.taskReload"
                                           projectId="state.selectedId"/>
                        </t>
                        <!-- OVERVIEW -->
                        <t t-elif="state.view === 'overview'">
                            <div class="o_msp_overview">
                                <div class="o_msp_card">
                                    <div class="o_msp_card_head">
                                        <span>Voortgang</span>
                                        <span t-esc="Math.round(selected.progress) + '%'"/>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar"
                                             t-attf-style="width: {{ selected.progress }}%;"/>
                                    </div>
                                </div>
                                <div class="o_msp_cols">
                                    <div class="o_msp_card">
                                        <div class="o_msp_card_head">
                                            <span>Taken</span>
                                            <span t-if="state.overview" class="text-muted"
                                                  t-esc="state.overview.taskTotal"/>
                                        </div>
                                        <t t-if="state.overview">
                                            <div t-foreach="taskStates" t-as="ts" t-key="ts.key"
                                                 class="o_msp_row">
                                                <span t-esc="ts.label"/>
                                                <span class="badge bg-secondary"
                                                      t-esc="state.overview.taskCounts[ts.key] || 0"/>
                                            </div>
                                        </t>
                                    </div>
                                    <div class="o_msp_card">
                                        <div class="o_msp_card_head"><span>Milestones</span></div>
                                        <t t-if="state.overview">
                                            <t t-if="state.overview.milestones.length">
                                                <div t-foreach="state.overview.milestones" t-as="m"
                                                     t-key="m.id" class="o_msp_row">
                                                    <span t-esc="m.name"/>
                                                    <span class="text-muted" t-esc="m.date_deadline or '—'"/>
                                                </div>
                                            </t>
                                            <div t-else="" class="text-muted">Geen milestones</div>
                                        </t>
                                    </div>
                                </div>
                                <div class="o_msp_card"
                                     t-if="state.overview and state.overview.children.length">
                                    <div class="o_msp_card_head"><span>Sub-projecten</span></div>
                                    <div t-foreach="state.overview.children" t-as="c" t-key="c.id"
                                         class="o_msp_row o_msp_clickable"
                                         t-on-click="() => this.selectProject(c.id)">
                                        <span t-esc="c.name"/>
                                        <span class="text-muted" t-esc="Math.round(c.progress) + '%'"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <!-- BOARD / LIST / CALENDAR -->
                        <t t-else="">
                            <View t-key="state.selectedId + '-' + state.view + '-' + state.taskReload"
                                  t-props="taskViewProps"/>
                        </t>
                    </div>
                </t>
            </div>

            <WsContextMenu t-if="state.ctx" x="state.ctx.x" y="state.ctx.y"
                           title="'Project'" items="ctxItems"
                           onAction.bind="onCtxAction" onClose.bind="closeCtx"/>
        </div>
    </t>

</templates>
