<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ TASK TEMPLATE — LIST ============ -->
    <record id="myschool_project_task_template_view_list" model="ir.ui.view">
        <field name="name">myschool.project.task.template.list</field>
        <field name="model">myschool.project.task.template</field>
        <field name="arch" type="xml">
            <list string="Task Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="item_type"/>
                <field name="child_count" string="Sub-items"/>
            </list>
        </field>
    </record>

    <!-- ============ TASK TEMPLATE — FORM ============ -->
    <record id="myschool_project_task_template_view_form" model="ir.ui.view">
        <field name="name">myschool.project.task.template.form</field>
        <field name="model">myschool.project.task.template</field>
        <field name="arch" type="xml">
            <form string="Task Template">
                <header>
                    <button name="action_open_apply_wizard" type="object"
                            string="Apply to project…" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Template name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="item_type"/>
                            <field name="priority"/>
                            <field name="planned_hours"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sub-items" name="children">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="item_type"/>
                                    <field name="priority"/>
                                    <field name="planned_hours" sum="Planned"/>
                                    <field name="child_count" string="Subs"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="myschool_project_task_template_action" model="ir.actions.act_window">
        <field name="name">Task Templates</field>
        <field name="res_model">myschool.project.task.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('parent_id', '=', False)]</field>
        <field name="context">{'default_parent_id': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Maak een herbruikbaar taak-blok
            </p>
            <p>
                Bouw een standaard takenstructuur (bv. "Onboarding checklist")
                één keer en voeg hem telkens toe aan een project via
                <b>Apply to project</b> — of bewaar een bestaande taak-subtree
                als template via <b>Save as task template</b>.
            </p>
        </field>
    </record>

    <!-- ============ APPLY WIZARD ============ -->
    <record id="myschool_project_task_template_apply_view_form" model="ir.ui.view">
        <field name="name">myschool.project.task.template.apply.form</field>
        <field name="model">myschool.project.task.template.apply</field>
        <field name="arch" type="xml">
            <form string="Apply Task Template">
                <group>
                    <field name="template_id"/>
                    <field name="project_id"/>
                    <field name="parent_id"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
