<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LIST ============ -->
    <record id="myschool_project_view_list" model="ir.ui.view">
        <field name="name">myschool.project.list</field>
        <field name="model">myschool.project</field>
        <field name="arch" type="xml">
            <list string="Projects">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="parent_id" optional="hide"/>
                <field name="category_id" optional="show"/>
                <field name="responsible_id" optional="show"/>
                <field name="child_count" string="Subs" optional="show"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'on_hold'"
                       decoration-muted="state in ('done', 'cancelled')"/>
                <field name="progress" widget="progressbar"/>
                <field name="date_start" optional="hide"/>
                <field name="date_end" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="myschool_project_view_form" model="ir.ui.view">
        <field name="name">myschool.project.form</field>
        <field name="model">myschool.project</field>
        <field name="arch" type="xml">
            <form string="Project">
                <header>
                    <button name="action_create_from_template" type="object"
                            string="Create project from template"
                            class="btn-primary" invisible="not is_template"/>
                    <button name="action_save_as_template" type="object"
                            string="Save as template" invisible="is_template"/>
                    <button name="action_add_task_template" type="object"
                            string="Add from task template" invisible="is_template"/>
                    <button name="action_apply_process" type="object"
                            string="Voeg proces in" invisible="is_template"/>
                    <field name="state" widget="statusbar"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <widget name="web_ribbon" title="Template" bg_color="text-bg-info"
                            invisible="not is_template"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_tasks"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="open_task_count" widget="statinfo" string="Open Tasks"/>
                        </button>
                        <button type="object" name="action_open_subprojects"
                                class="oe_stat_button" icon="fa-sitemap"
                                invisible="child_count == 0">
                            <field name="child_count" widget="statinfo" string="Sub-projects"/>
                        </button>
                        <button type="object" name="action_open_milestones"
                                class="oe_stat_button" icon="fa-flag-checkered">
                            <field name="milestone_count" widget="statinfo" string="Milestones"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Project name"/>
                        </h1>
                        <label for="code" class="oe_inline"/>
                        <field name="code" class="oe_inline" placeholder="e.g. OLVP-ICT"/>
                    </div>
                    <group>
                        <group string="Organisation">
                            <field name="parent_id"/>
                            <field name="category_id"/>
                            <field name="is_template"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Planning &amp; Progress">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="progress_own" widget="progressbar"
                                   invisible="child_count &gt; 0 or task_count &gt; 0"/>
                            <field name="progress" widget="progressbar"/>
                            <label for="done_task_count" string="Tasks"
                                   invisible="task_count == 0"/>
                            <div invisible="task_count == 0">
                                <field name="done_task_count" class="oe_inline"/> /
                                <field name="task_count" class="oe_inline"/> done
                                (<field name="open_task_count" class="oe_inline"/> open)
                            </div>
                            <field name="child_count" invisible="1"/>
                            <field name="task_count" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sub-projects" name="subprojects">
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="responsible_id"/>
                                    <field name="state" widget="badge"/>
                                    <field name="progress" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                        <page string="Work Items" name="tasks">
                            <field name="task_ids" context="{'default_project_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="item_type" widget="badge"
                                           decoration-info="item_type == 'milestone'"
                                           decoration-warning="item_type == 'bug'"
                                           decoration-primary="item_type == 'epic'"/>
                                    <field name="name"/>
                                    <field name="assigned_id" widget="many2one_avatar_user"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="date_deadline"/>
                                    <field name="planned_hours" sum="Planned"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'todo'"
                                           decoration-primary="state == 'in_progress'"
                                           decoration-warning="state == 'blocked'"
                                           decoration-success="state == 'done'"
                                           decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Milestones" name="milestones">
                            <field name="milestone_ids"
                                   context="{'default_project_id': id, 'default_item_type': 'milestone'}">
                                <list editable="bottom" default_order="date_deadline">
                                    <field name="item_type" column_invisible="1"/>
                                    <field name="date_deadline" string="Date"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'todo'"
                                           decoration-success="state == 'done'"
                                           decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Team" name="team">
                            <field name="membership_ids">
                                <list editable="bottom">
                                    <field name="user_id"/>
                                    <field name="role"/>
                                </list>
                            </field>
                            <group>
                                <field name="member_ids" widget="many2many_tags"
                                       readonly="1" string="All with access"/>
                            </group>
                        </page>
                        <page string="Dependencies" name="dependencies">
                            <group>
                                <field name="depends_on_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       domain="[('id', '!=', id)]"/>
                                <field name="dependent_ids" widget="many2many_tags" readonly="1"/>
                            </group>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="myschool_project_view_search" model="ir.ui.view">
        <field name="name">myschool.project.search</field>
        <field name="model">myschool.project</field>
        <field name="arch" type="xml">
            <search string="Projects">
                <field name="name"/>
                <field name="code"/>
                <field name="responsible_id"/>
                <field name="parent_id"/>
                <field name="category_id"/>
                <filter name="top_level" string="Top-level only"
                        domain="[('parent_id', '=', False)]"/>
                <separator/>
                <filter name="active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="on_hold" string="On Hold" domain="[('state', '=', 'on_hold')]"/>
                <filter name="open" string="Not Closed"
                        domain="[('state', 'not in', ('done', 'cancelled'))]"/>
                <separator/>
                <filter name="my_projects" string="My Projects"
                        domain="['|', ('responsible_id', '=', uid), ('member_ids', 'in', uid)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_category" string="Category"
                        context="{'group_by': 'category_id'}"/>
                <filter name="group_parent" string="Parent Project"
                        context="{'group_by': 'parent_id'}"/>
                <filter name="group_responsible" string="Responsible"
                        context="{'group_by': 'responsible_id'}"/>
                <filter name="group_state" string="State"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ============ KANBAN ============ -->
    <record id="myschool_project_view_kanban" model="ir.ui.view">
        <field name="name">myschool.project.kanban</field>
        <field name="model">myschool.project</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="state">
                <field name="progress"/>
                <field name="open_task_count"/>
                <field name="milestone_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <span t-if="record.code.raw_value" class="text-muted ms-1">
                                <field name="code"/>
                            </span>
                        </div>
                        <div class="o_kanban_record_body">
                            <field name="progress" widget="progressbar"/>
                            <div class="text-muted mt-1">
                                <span t-if="record.open_task_count.raw_value">
                                    <i class="fa fa-tasks" role="img" aria-label="Tasks"/>
                                    <t t-out="record.open_task_count.value"/> open
                                </span>
                                <span t-if="record.milestone_count.raw_value" class="ms-2">
                                    <i class="fa fa-flag-checkered" role="img" aria-label="Milestones"/>
                                    <t t-out="record.milestone_count.value"/>
                                </span>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left"/>
                            <div class="oe_kanban_bottom_right">
                                <field name="responsible_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="myschool_project_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">myschool.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="myschool_project_view_search"/>
        <field name="domain">[('is_template', '=', False)]</field>
        <field name="context">{'search_default_top_level': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Maak je eerste project aan
            </p>
            <p>
                Projecten kunnen sub-projecten bevatten (WBS). De voortgang
                van een project rolt automatisch op uit zijn sub-projecten.
            </p>
        </field>
    </record>

    <!-- ============ TEMPLATES ============ -->
    <record id="myschool_project_template_action" model="ir.actions.act_window">
        <field name="name">Project Templates</field>
        <field name="res_model">myschool.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="myschool_project_view_search"/>
        <field name="domain">[('is_template', '=', True)]</field>
        <field name="context">{'default_is_template': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Maak een project-template
            </p>
            <p>
                Een template is een blueprint: bouw de structuur (sub-projecten,
                work items, milestones, dependencies) één keer en instantieer hem
                telkens opnieuw tot een echt project via de knop
                <b>Create project from template</b>.
            </p>
        </field>
    </record>

    <!-- ============ PROJECT CATEGORY ============ -->
    <record id="myschool_project_category_view_list" model="ir.ui.view">
        <field name="name">myschool.project.category.list</field>
        <field name="model">myschool.project.category</field>
        <field name="arch" type="xml">
            <list string="Project Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="project_count"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="myschool_project_category_action" model="ir.actions.act_window">
        <field name="name">Project Categories</field>
        <field name="res_model">myschool.project.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ INSERT PROCESS WIZARD ============ -->
    <record id="myschool_project_process_apply_view_form" model="ir.ui.view">
        <field name="name">myschool.project.process.apply.form</field>
        <field name="model">myschool.project.process.apply</field>
        <field name="arch" type="xml">
            <form string="Voeg proces in">
                <group>
                    <field name="process_id" options="{'no_create': True}"
                           domain="[('state', '=', 'approved')] if not show_unapproved else []"/>
                    <field name="show_unapproved"/>
                    <field name="project_id"/>
                    <field name="parent_id"/>
                </group>
                <p class="text-muted">
                    Elke processtap wordt een work item onder een phase met de
                    procesnaam. De flow tussen stappen wordt vertaald naar
                    afhankelijkheden.
                </p>
                <footer>
                    <button name="action_apply" type="object" string="Voeg in"
                            class="btn-primary"/>
                    <button string="Annuleer" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
