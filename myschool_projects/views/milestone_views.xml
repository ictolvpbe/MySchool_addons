<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LIST ============ -->
    <record id="myschool_project_milestone_view_list" model="ir.ui.view">
        <field name="name">myschool.project.milestone.list</field>
        <field name="model">myschool.project.milestone</field>
        <field name="arch" type="xml">
            <list string="Milestones" editable="bottom" default_order="date">
                <field name="sequence" widget="handle"/>
                <field name="date"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'pending'"
                       decoration-success="state == 'reached'"
                       decoration-danger="state == 'missed'"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="myschool_project_milestone_view_form" model="ir.ui.view">
        <field name="name">myschool.project.milestone.form</field>
        <field name="model">myschool.project.milestone</field>
        <field name="arch" type="xml">
            <form string="Milestone">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Milestone name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Description..."/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ CALENDAR (community timeline) ============ -->
    <record id="myschool_project_milestone_view_calendar" model="ir.ui.view">
        <field name="name">myschool.project.milestone.calendar</field>
        <field name="model">myschool.project.milestone</field>
        <field name="arch" type="xml">
            <calendar string="Milestones" date_start="date" color="project_id" mode="month">
                <field name="project_id" filters="1"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="myschool_project_milestone_view_search" model="ir.ui.view">
        <field name="name">myschool.project.milestone.search</field>
        <field name="model">myschool.project.milestone</field>
        <field name="arch" type="xml">
            <search string="Milestones">
                <field name="name"/>
                <field name="project_id"/>
                <filter name="pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="reached" string="Reached" domain="[('state', '=', 'reached')]"/>
                <filter name="missed" string="Missed" domain="[('state', '=', 'missed')]"/>
                <separator/>
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="myschool_project_milestone_action" model="ir.actions.act_window">
        <field name="name">Milestones</field>
        <field name="res_model">myschool.project.milestone</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="myschool_project_milestone_view_search"/>
    </record>

</odoo>
