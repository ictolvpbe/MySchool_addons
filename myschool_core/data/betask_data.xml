<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- ========================================= -->
        <!-- SEQUENCES -->
        <!-- ========================================= -->
        
        <record id="seq_betask" model="ir.sequence">
            <field name="name">Backend Task Sequence</field>
            <field name="code">myschool.betask</field>
            <field name="prefix">BT</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ========================================= -->
        <!-- STANDARD TASK TYPES -->
        <!-- ========================================= -->
        
        <!-- Database Operations - Organizations -->
        <record id="betask_type_db_org_add" model="myschool.betask.type">
            <field name="name">DB_ORG_ADD</field>
            <field name="target">DB</field>
            <field name="object">ORG</field>
            <field name="action">ADD</field>
            <field name="description">Add organization to database</field>
            <field name="processor_method">process_db_org_add</field>
            <field name="priority">10</field>
        </record>

        <record id="betask_type_db_org_update" model="myschool.betask.type">
            <field name="name">DB_ORG_UPDATE</field>
            <field name="target">DB</field>
            <field name="object">ORG</field>
            <field name="action">UPDATE</field>
            <field name="description">Update organization in database</field>
            <field name="processor_method">process_db_org_update</field>
            <field name="priority">10</field>
        </record>

        <!-- DB/STUDENT/* + DB/EMPLOYEE/* types verwijderd (2026-06-18):
             legacy, vervangen door het generieke DB/PERSON/*-spoor (0 instanties,
             niets maakt ze aan). Wees-records worden gewist door migratie
             1.1/post-migrate.py. -->

        <!-- Database Operations - Roles -->
        <record id="betask_type_db_role_add" model="myschool.betask.type">
            <field name="name">DB_ROLE_ADD</field>
            <field name="target">DB</field>
            <field name="object">ROLE</field>
            <field name="action">ADD</field>
            <field name="description">Add role to database</field>
            <field name="processor_method">process_db_role_add</field>
            <field name="priority">15</field>
        </record>

        <!-- Database Operations - Relations -->
        <record id="betask_type_db_relation_add" model="myschool.betask.type">
            <field name="name">DB_RELATION_ADD</field>
            <field name="target">DB</field>
            <field name="object">RELATION</field>
            <field name="action">ADD</field>
            <field name="description">Add relation to database</field>
            <field name="priority">25</field>
        </record>

        <!-- LDAP/AD Operations -->
        <record id="betask_type_ldap_org_add" model="myschool.betask.type">
            <field name="name">LDAP_ORG_ADD</field>
            <field name="target">LDAP</field>
            <field name="object">ORG</field>
            <field name="action">ADD</field>
            <field name="description">Add organization to LDAP/Active Directory</field>
            <field name="processor_method">process_ldap_org_add</field>
            <field name="priority">30</field>
        </record>

        <record id="betask_type_ldap_org_del" model="myschool.betask.type">
            <field name="name">LDAP_ORG_DEL</field>
            <field name="target">LDAP</field>
            <field name="object">ORG</field>
            <field name="action">DEL</field>
            <field name="description">Delete OU (organisational unit) from LDAP/Active Directory</field>
            <field name="processor_method">process_ldap_ou_del</field>
            <field name="priority">90</field>
        </record>

        <!-- LDAP/STUDENT/* + LDAP/EMPLOYEE/* types verwijderd (2026-06-18):
             legacy, vervangen door het generieke LDAP/USER/*-spoor. Hadden 0
             instanties en geen processor. De wees-records (zonder xmlid, ooit
             door de dode ensure_standard_types-seeder gemaakt) worden door de
             migratie 1.1/post-migrate.py opgekuist. -->

        <!-- All Systems Operations -->
        <record id="betask_type_all_role_upd" model="myschool.betask.type">
            <field name="name">ALL_ROLE_UPD</field>
            <field name="target">ALL</field>
            <field name="object">ROLE</field>
            <field name="action">UPD</field>
            <field name="description">Update role in all systems</field>
            <field name="priority">40</field>
        </record>

        <!-- Manual Tasks -->
        <record id="betask_type_manual_config" model="myschool.betask.type">
            <field name="name">MANUAL_CONFIG_MANUAL</field>
            <field name="target">MANUAL</field>
            <field name="object">CONFIG</field>
            <field name="action">MANUAL</field>
            <field name="description">Manual configuration task requiring human intervention</field>
            <field name="auto_process">False</field>
            <field name="requires_confirmation">True</field>
            <field name="priority">100</field>
        </record>

    </data>

    <!-- ========================================= -->
    <!-- UNIFIED PERSON TYPES + CLEANUP -->
    <!-- ========================================= -->

    <data noupdate="0">

        <!-- Unified DB PERSON types (replace separate EMPLOYEE/STUDENT types) -->
        <record id="betask_type_db_person_add" model="myschool.betask.type">
            <field name="name">DB_PERSON_ADD</field>
            <field name="target">DB</field>
            <field name="object">PERSON</field>
            <field name="action">ADD</field>
            <field name="description">Add person to database (employee or student)</field>
            <field name="processor_method">process_db_person_add</field>
            <field name="priority">20</field>
        </record>

        <record id="betask_type_db_person_upd" model="myschool.betask.type">
            <field name="name">DB_PERSON_UPD</field>
            <field name="target">DB</field>
            <field name="object">PERSON</field>
            <field name="action">UPD</field>
            <field name="description">Update person in database</field>
            <field name="processor_method">process_db_person_upd</field>
            <field name="priority">20</field>
        </record>

        <record id="betask_type_db_person_deact" model="myschool.betask.type">
            <field name="name">DB_PERSON_DEACT</field>
            <field name="target">DB</field>
            <field name="object">PERSON</field>
            <field name="action">DEACT</field>
            <field name="description">Deactivate person in database</field>
            <field name="processor_method">process_db_person_deact</field>
            <field name="priority">20</field>
        </record>

        <!-- (DB/EMPLOYEE/* + DB/STUDENT/* definities verwijderd — zie boven;
             wees-records gewist door migratie 1.1/post-migrate.py.) -->

        <!-- Deactivate unused types -->
        <record id="betask_type_ldap_org_add" model="myschool.betask.type">
            <field name="active" eval="False"/>
        </record>
        <!-- ldap_student_add / ldap_employee_add / ldap_employee_upd:
             definities verwijderd (zie boven) — niet langer deactiveren. -->
        <record id="betask_type_all_role_upd" model="myschool.betask.type">
            <field name="active" eval="False"/>
        </record>
        <record id="betask_type_manual_config" model="myschool.betask.type">
            <field name="active" eval="False"/>
        </record>

    </data>

    <!-- ========================================= -->
    <!-- SCHEDULED ACTIONS (CRON JOBS) — VERHUISD -->
    <!-- ========================================= -->
    <!--
        Alle cron-records (process-betasks, cleanup-betasks én
        employee-account-lifecycle) staan nu in data/cloud_cron.xml,
        dat WEL in de core-manifest geladen wordt. Dit bestand
        (betask_data.xml) staat NIET in de manifest — vroeger stonden
        de crons hier met Odoo ≤18-velden (numbercall/doall) waardoor
        de lifecycle-flow stil gestopt is. Niet opnieuw hier toevoegen.

        Idem de "Verwerk alle wachtende taken"-server-action: die staat
        in myschool_admin (myschool_admin.action_betask_run_all_pending);
        betask.action_run_all_pending() ketent er guarded naar.
    -->
</odoo>
