<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Opruimen van gegenereerde brief-PDF's.

            Welkomstbrieven bevatten een plaintext-wachtwoord
            ({{ object.password }}); de gegenereerde ir.attachment blijft
            anders onbeperkt op de persoon staan. Deze dagelijkse cron
            verwijdert brief-PDF's ouder dan de bewaartermijn
            (_LETTER_ATTACHMENT_RETENTION_DAYS, default 30 dagen).
        -->
        <record id="ir_cron_letter_attachment_cleanup" model="ir.cron">
            <field name="name">Brief-PDF's opruimen (wachtwoord-veiligheid)</field>
            <field name="model_id" ref="model_myschool_letter_template"/>
            <field name="state">code</field>
            <field name="code">model._cron_cleanup_letter_attachments()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(DateTime.now().replace(hour=3, minute=0, second=0) + relativedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
