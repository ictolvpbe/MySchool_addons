<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

    <record id="module_category_itsm" model="ir.module.category">
        <field name="name">IT Service Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="privilege_itsm" model="res.groups.privilege">
        <field name="name">Rol</field>
        <field name="placeholder">Geen toegang</field>
        <field name="category_id" ref="module_category_itsm"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_itsm_user" model="res.groups">
        <field name="name">ITSM User</field>
        <field name="privilege_id" ref="privilege_itsm"/>
        <field name="sequence">10</field>
        <field name="implied_ids" eval="[(4, ref('myschool_core.group_myschool_core_user'))]"/>
        <field name="comment">Read access to ITSM. Can submit tickets.</field>
    </record>

    <record id="group_itsm_agent" model="res.groups">
        <field name="name">ITSM Agent</field>
        <field name="privilege_id" ref="privilege_itsm"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_itsm_user'))]"/>
        <field name="comment">IT support agent. Can manage tickets, problems, and knowledge.</field>
    </record>

    <record id="group_itsm_manager" model="res.groups">
        <field name="name">ITSM Manager</field>
        <field name="privilege_id" ref="privilege_itsm"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_itsm_agent'))]"/>
        <field name="comment">Full ITSM access including changes, services, SLAs, and CMDB.</field>
    </record>

    <!-- =====================================================================
         Ticket write-rules. De ACL geeft itsm_user write op itsm.ticket,
         maar zonder rule kon elke melder ÁLLE tickets wijzigen. Een melder
         (itsm_user) mag enkel tickets schrijven die hij zelf aanmaakte of
         volgt; agents/managers mogen alles (OR-regel — agent implied user).
         ===================================================================== -->
    <record id="itsm_ticket_user_write_own_rule" model="ir.rule">
        <field name="name">ITSM Ticket: melder — enkel eigen/gevolgde tickets schrijven</field>
        <field name="model_id" ref="model_itsm_ticket"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('group_itsm_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="itsm_ticket_agent_write_all_rule" model="ir.rule">
        <field name="name">ITSM Ticket: agent/manager — alle tickets schrijven</field>
        <field name="model_id" ref="model_itsm_ticket"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_itsm_agent'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    </data>
</odoo>
