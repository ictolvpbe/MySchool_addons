<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LIST ============ -->
    <record id="myschool_server_property_view_list" model="ir.ui.view">
        <field name="name">myschool.server.property.list</field>
        <field name="model">myschool.server.property</field>
        <field name="arch" type="xml">
            <list string="Server Properties" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="module_names" optional="show"/>
                <field name="role_count" string="Roles"/>
                <field name="color" widget="color_picker" optional="hide"/>
                <field name="description" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="myschool_server_property_view_form" model="ir.ui.view">
        <field name="name">myschool.server.property.form</field>
        <field name="model">myschool.server.property</field>
        <field name="arch" type="xml">
            <form string="Server Property">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="bv. Host webapps"/></h1>
                        <label for="code" class="oe_inline"/>
                        <field name="code" class="oe_inline" placeholder="bv. host_webapps"/>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="module_names"
                                   placeholder="bv. myschool_assets,myschool_sync"/>
                            <field name="role_count"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="myschool_server_property_view_search" model="ir.ui.view">
        <field name="name">myschool.server.property.search</field>
        <field name="model">myschool.server.property</field>
        <field name="arch" type="xml">
            <search string="Server Properties">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_category" string="Category"
                        context="{'group_by': 'category'}"/>
            </search>
        </field>
    </record>

    <record id="myschool_server_property_action" model="ir.actions.act_window">
        <field name="name">Server Properties</field>
        <field name="res_model">myschool.server.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="myschool_server_property_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Maak een eigenschap aan
            </p>
            <p>
                Eigenschappen zijn de herbruikbare bouwstenen waaruit
                server-rollen worden samengesteld.
            </p>
        </field>
    </record>

</odoo>
