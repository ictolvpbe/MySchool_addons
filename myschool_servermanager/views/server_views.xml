<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LIST ============ -->
    <record id="myschool_server_view_list" model="ir.ui.view">
        <field name="name">myschool.server.list</field>
        <field name="model">myschool.server</field>
        <field name="arch" type="xml">
            <list string="Servers">
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="fqdn" optional="show"/>
                <field name="environment" widget="badge"
                       decoration-danger="environment == 'prod'"
                       decoration-warning="environment == 'test'"
                       decoration-info="environment == 'dev'"/>
                <field name="role_id" optional="show"/>
                <field name="db_name" optional="hide"/>
                <field name="enrollment_state" widget="badge" optional="show"
                       decoration-success="enrollment_state == 'done'"
                       decoration-danger="enrollment_state == 'error'"
                       decoration-muted="enrollment_state == 'pending'"/>
                <field name="responsible_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="myschool_server_view_form" model="ir.ui.view">
        <field name="name">myschool.server.form</field>
        <field name="model">myschool.server</field>
        <field name="arch" type="xml">
            <form string="Server">
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Connection" icon="fa-plug"
                            groups="myschool_servermanager.group_servermanager_manager"/>
                    <button name="action_enroll" type="object"
                            string="Enroll" class="btn-primary"
                            confirm="Enrollment past de standaard-instellingen van de rol toe op de remote server. Doorgaan?"
                            groups="myschool_servermanager.group_servermanager_manager"/>
                    <button name="action_provision" type="object"
                            string="Provision" icon="fa-magic"
                            confirm="Provisioning voorziet de remote server van base-data (company) en de default-gebruikers van de rol. Doorgaan?"
                            groups="myschool_servermanager.group_servermanager_manager"/>
                    <field name="enrollment_state" widget="statusbar"
                           statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_data_locations"
                                class="oe_stat_button" icon="fa-database"
                                invisible="data_location_count == 0">
                            <field name="data_location_count" widget="statinfo"
                                   string="Data Domains"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="bv. srvv-odoo-01"/></h1>
                        <label for="code" class="oe_inline"/>
                        <field name="code" class="oe_inline" placeholder="bv. ODOO01"/>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="environment"/>
                            <field name="role_id"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Database / Instance">
                            <field name="db_name"/>
                            <field name="instance_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Network &amp; Connection">
                            <field name="fqdn"/>
                            <field name="ip_address"/>
                            <field name="use_https"/>
                            <field name="ssh_port"/>
                            <field name="http_port"/>
                            <field name="api_endpoint" widget="url"/>
                        </group>
                        <group string="RPC Credentials"
                               groups="myschool_servermanager.group_servermanager_manager">
                            <field name="login"/>
                            <field name="api_key" password="True"/>
                            <field name="target_admin_password" password="True"/>
                            <field name="connection_state" widget="badge"
                                   decoration-success="connection_state == 'ok'"
                                   decoration-danger="connection_state == 'error'"
                                   decoration-muted="connection_state == 'unknown'"/>
                            <field name="connection_message" readonly="1"
                                   invisible="not connection_message"/>
                            <field name="last_connection_check" readonly="1"
                                   invisible="not last_connection_check"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Effective Properties" name="properties">
                            <field name="property_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Eigenschappen worden geërfd van de toegekende rol.
                            </p>
                        </page>
                        <page string="Data &amp; Privacy" name="data_locations">
                            <field name="data_location_ids"
                                   context="{'default_server_id': id}">
                                <list editable="bottom">
                                    <field name="domain_id"/>
                                    <field name="is_pii" widget="boolean_toggle" readonly="1"/>
                                    <field name="location" widget="badge"
                                           decoration-success="location == 'local'"
                                           decoration-warning="location == 'remote'"/>
                                    <field name="source_server_id"
                                           readonly="location != 'remote'"
                                           required="location == 'remote'"/>
                                    <field name="endpoint" optional="hide"/>
                                    <field name="notes" optional="show"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Per data-domein: staat de data lokaal of wordt ze
                                via API bij een bronserver opgehaald (privacy).
                            </p>
                        </page>
                        <page string="Enrollment" name="enrollment">
                            <group>
                                <group string="Plan (from role)">
                                    <field name="role_id"/>
                                    <field name="enroll_lang" readonly="1"
                                           string="Default Language"/>
                                    <field name="enroll_module_names" readonly="1"
                                           string="Modules to Install"/>
                                </group>
                                <group string="Status">
                                    <field name="enrollment_state"/>
                                    <field name="last_enrolled" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Enrollment Log"/>
                            <field name="enrollment_log" readonly="1" nolabel="1"
                                   invisible="not enrollment_log"/>
                        </page>
                        <page string="Provisioning" name="provisioning">
                            <group>
                                <group string="Status">
                                    <field name="provision_state"/>
                                    <field name="last_provisioned" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Companies (base data)"/>
                            <field name="provision_company_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="parent_id"/>
                                    <field name="is_main" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                De hoofd-company (<i>Main Company</i>) hernoemt de
                                bestaande company van de remote; sub-companies
                                verwijzen via <i>Parent Company</i> en worden
                                idempotent (op naam) aangemaakt.
                            </p>
                            <separator string="Default Users (from role)"/>
                            <field name="provision_user_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="login"/>
                                    <field name="email" optional="show"/>
                                    <field name="lang" optional="hide"/>
                                    <field name="is_admin" widget="boolean_toggle"/>
                                </list>
                            </field>
                            <p class="text-muted">
                                Default-gebruikers worden beheerd op de rol en
                                idempotent op de remote aangemaakt (op login).
                            </p>
                            <separator string="Provisioning Log"/>
                            <field name="provision_log" readonly="1" nolabel="1"
                                   invisible="not provision_log"/>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="myschool_server_view_search" model="ir.ui.view">
        <field name="name">myschool.server.search</field>
        <field name="model">myschool.server</field>
        <field name="arch" type="xml">
            <search string="Servers">
                <field name="name"/>
                <field name="code"/>
                <field name="fqdn"/>
                <field name="role_id"/>
                <field name="db_name"/>
                <separator/>
                <filter name="prod" string="Production" domain="[('environment', '=', 'prod')]"/>
                <filter name="test" string="Test" domain="[('environment', '=', 'test')]"/>
                <filter name="dev" string="Development" domain="[('environment', '=', 'dev')]"/>
                <separator/>
                <filter name="my_servers" string="My Servers"
                        domain="[('responsible_id', '=', uid)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_environment" string="Environment"
                        context="{'group_by': 'environment'}"/>
                <filter name="group_role" string="Role"
                        context="{'group_by': 'role_id'}"/>
                <filter name="group_responsible" string="Responsible"
                        context="{'group_by': 'responsible_id'}"/>
            </search>
        </field>
    </record>

    <!-- ============ KANBAN ============ -->
    <record id="myschool_server_view_kanban" model="ir.ui.view">
        <field name="name">myschool.server.kanban</field>
        <field name="model">myschool.server</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_small_column" default_group_by="environment">
                <field name="role_id"/>
                <field name="fqdn"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <span t-if="record.code.raw_value" class="text-muted ms-1">
                                <field name="code"/>
                            </span>
                        </div>
                        <div class="o_kanban_record_body">
                            <div t-if="record.fqdn.raw_value" class="text-muted">
                                <i class="fa fa-globe" role="img" aria-label="FQDN"/>
                                <t t-out="record.fqdn.value"/>
                            </div>
                            <div t-if="record.role_id.raw_value">
                                <i class="fa fa-id-badge" role="img" aria-label="Role"/>
                                <t t-out="record.role_id.value"/>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left"/>
                            <div class="oe_kanban_bottom_right">
                                <field name="responsible_id" widget="many2one_avatar_user"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="myschool_server_action" model="ir.actions.act_window">
        <field name="name">Servers</field>
        <field name="res_model">myschool.server</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="myschool_server_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registreer je eerste server
            </p>
            <p>
                Houd per Odoo-instance/server de netwerk- &amp; connectiegegevens,
                environment, database en rol bij.
            </p>
        </field>
    </record>

</odoo>
