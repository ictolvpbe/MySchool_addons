<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ LIST ============ -->
    <record id="myschool_server_role_view_list" model="ir.ui.view">
        <field name="name">myschool.server.role.list</field>
        <field name="model">myschool.server.role</field>
        <field name="arch" type="xml">
            <list string="Server Roles">
                <field name="sequence" widget="handle"/>
                <field name="code" optional="show"/>
                <field name="name"/>
                <field name="property_count" string="Properties"/>
                <field name="server_count" string="Servers"/>
            </list>
        </field>
    </record>

    <!-- ============ FORM ============ -->
    <record id="myschool_server_role_view_form" model="ir.ui.view">
        <field name="name">myschool.server.role.form</field>
        <field name="model">myschool.server.role</field>
        <field name="arch" type="xml">
            <form string="Server Role">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_servers"
                                class="oe_stat_button" icon="fa-server"
                                invisible="server_count == 0">
                            <field name="server_count" widget="statinfo" string="Servers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="bv. Webapps server"/></h1>
                        <label for="code" class="oe_inline"/>
                        <field name="code" class="oe_inline" placeholder="bv. webapps"/>
                    </div>
                    <group>
                        <field name="property_ids" widget="many2many_tags"
                               options="{'color_field': 'color'}"
                               string="Composed of properties"/>
                    </group>
                    <notebook>
                        <page string="Properties" name="properties">
                            <field name="property_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="myschool_server_role_view_search" model="ir.ui.view">
        <field name="name">myschool.server.role.search</field>
        <field name="model">myschool.server.role</field>
        <field name="arch" type="xml">
            <search string="Server Roles">
                <field name="name"/>
                <field name="code"/>
                <field name="property_ids"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="myschool_server_role_action" model="ir.actions.act_window">
        <field name="name">Server Roles</field>
        <field name="res_model">myschool.server.role</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="myschool_server_role_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Maak een server-rol aan
            </p>
            <p>
                Een rol (account-server, webapps-server, ...) is samengesteld
                uit eigenschappen. Servers erven hun eigenschappen van hun rol.
            </p>
        </field>
    </record>

</odoo>
